<Window x:Class="Demo.CombineFolder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="CombineFolder" Height="550" Width="800">

    <StackPanel>
        <StackPanel>
            <TextBlock Text="Employee Registration" 
                       FontWeight="Bold"
                       Width="275"
                       Height="40"
                       FontSize="26"></TextBlock>
        </StackPanel>
        <StackPanel Margin="15">
            <TextBlock Text="Name"
                   Margin="0,5"
                   Foreground="Black"/>
            <TextBox Height="20"
                     Margin="0,0,0,8"
                     Name="txtname"/>
            <TextBlock Text="User Name"
                   Margin="0,5"
                   Foreground="Black"/>
            <TextBox Height="20"
                 Margin="0,0,0,8"
                     Name="txtusername"/>
            <TextBlock Text="Password"
                   Margin="0,5"
                   Foreground="Black"/>
            <PasswordBox Height="20"
                         Margin="0,0,0,8"
                         Name="txtpassword"/>
            <TextBlock Text="Address Value"
                       Margin="0,5"
                       Foreground="Black"/>
            <TextBox Height="20"
                     Margin="0,0,0,6"
                     Name="txtaddressvalue"/>
            <TextBlock Text="Position"
                       Margin="0,5"
                       Foreground="Black"/>
            <TextBox Height="20"
                     Margin="0,0,0,8"
                     Name="txtposition"/>
            <TextBlock Text="Degree"
                       Margin="0,5"
                       Foreground="Black"/>
            <TextBox Height="20"
                     Margin="0,0,0,8"
                     Name="txtDegree"/>
        </StackPanel>
        <StackPanel>
            <Button Content="Register"
                    Width="160"
                    Height="35"
                    Margin="8"
                    Background="LightPink"
                    Click="Button_Click"/>

            <Button Content="Clear"
                    Width="160"
                    Height="35"
                    Margin="8"
                    Background="LightBlue"
                    Click="Button_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
